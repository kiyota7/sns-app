# docker-compose.prod.yml が読み込む環境変数のサンプル。
# コピーして .env という名前で保存し、実際の値を入力すること(.env はコミットしない)。
# 本番(EC2)では terraform の user_data がランダム生成したJWT_SECRETをもとに
# 自動生成するため、このファイルはローカルでdocker-compose.prod.ymlを試す場合の参考用。

JWT_SECRET=change-me-to-a-random-secret

# 投稿画像の保存先。local(デフォルト、./data/uploadsにファイル保存)またはs3。
# s3を指定する場合、AWS_S3_BUCKET/AWS_REGIONも設定すること(EC2上ではIAMインスタンス
# プロファイル経由で認証するため、アクセスキー等は不要)。
APP_STORAGE_TYPE=local
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-1

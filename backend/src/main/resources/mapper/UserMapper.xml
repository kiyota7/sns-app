<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.snsapp.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.snsapp.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="bio" column="bio"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.snsapp.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, email, password_hash, bio)
        VALUES (#{username}, #{email}, #{passwordHash}, #{bio})
    </insert>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findById" resultMap="UserResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <resultMap id="UserProfileResultMap" type="com.snsapp.model.UserProfile">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="bio" column="bio"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="followerCount" column="follower_count"/>
        <result property="followingCount" column="following_count"/>
        <result property="followedByCurrentUser" column="followed_by_current_user"/>
    </resultMap>

    <!--
        フォロー数・フォロワー数・自分がフォロー済みかを、PostMapperのselectWithAuthorと同じ考え方で
        相関サブクエリとして1本のSELECTに含めることでN+1を回避している。
    -->
    <select id="findProfileById" resultMap="UserProfileResultMap">
        SELECT users.id, users.username, users.bio, users.avatar_url,
               (SELECT COUNT(*) FROM follows WHERE followed_id = users.id) AS follower_count,
               (SELECT COUNT(*) FROM follows WHERE follower_id = users.id) AS following_count,
               EXISTS(
                   SELECT 1 FROM follows
                   WHERE follower_id = #{currentUserId} AND followed_id = users.id
               ) AS followed_by_current_user
        FROM users
        WHERE users.id = #{id}
    </select>

    <!-- avatarUrlが指定されなかった場合(アイコン画像を変更しない編集)は既存の値を保持する -->
    <update id="updateProfile">
        UPDATE users
        <set>
            username = #{username},
            bio = #{bio},
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
        </set>
        WHERE id = #{id}
    </update>

    <resultMap id="UserSearchResultMap" type="com.snsapp.model.UserSearchResult">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="followedByCurrentUser" column="followed_by_current_user"/>
    </resultMap>

    <select id="search" resultMap="UserSearchResultMap">
        SELECT users.id, users.username,
               EXISTS(
                   SELECT 1 FROM follows
                   WHERE follower_id = #{currentUserId} AND followed_id = users.id
               ) AS followed_by_current_user
        FROM users
        WHERE users.username LIKE '%' || #{query} || '%' AND users.id != #{currentUserId}
        ORDER BY users.username
    </select>

</mapper>
